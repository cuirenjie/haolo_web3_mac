NODE_ENV=production
HAOLO_GATEWAY_ROLE=all

# Gateway-internal signer for short-lived one-use private-egress permits.
# Generate an independent secret; never reuse the Haolo main-backend auth secret.
HAOLO_GATEWAY_JWT_SECRET=
HAOLO_GATEWAY_JWT_ISSUER=
HAOLO_GATEWAY_JWT_AUDIENCE=
HAOLO_AUTH_API_ORIGIN=https://haolo.com
HAOLO_AUTH_PROFILE_PATH=/api/auth/me
HAOLO_AUTH_REQUEST_TIMEOUT_MS=5000
HAOLO_AUTH_CACHE_TTL_MS=15000
HAOLO_GATEWAY_METRICS_TOKEN=
HAOLO_PRIVATE_SHARD_HASH_SECRET=

HAOLO_MARKET_GATEWAY_HOST=0.0.0.0
HAOLO_MARKET_GATEWAY_PORT=8787
HAOLO_MARKET_REDIS_URL=redis://redis:6379/0
HAOLO_GATEWAY_ALLOW_ANONYMOUS_PUBLIC=false
HAOLO_GATEWAY_TRUST_PROXY=false
# Per-user upstream request-weight budget; cached REST hits do not consume it.
HAOLO_MARKET_REQUESTS_PER_MINUTE=300
# Raw authenticated request ceiling, including cache hits, for abuse control.
HAOLO_MARKET_BURST_REQUESTS_PER_MINUTE=1200
# Stable identity for this public NAT egress; use a different value per EIP.
HAOLO_PUBLIC_EGRESS_ID=hk-public-a
# Shared public-egress budgets are coordinated atomically through Redis.
HAOLO_MARKET_FUTURES_WEIGHT_PER_MINUTE=1440
HAOLO_MARKET_SPOT_WEIGHT_PER_MINUTE=3600
HAOLO_MARKET_MAX_SUBSCRIPTIONS_PER_CLIENT=50
HAOLO_MARKET_MAX_STREAMS_PER_UPSTREAM=300
HAOLO_MARKET_MAX_WS_CLIENTS_PER_USER=8
HAOLO_MARKET_MAX_WS_CLIENTS_TOTAL=10000

# off: existing behavior; compatible: route upgraded clients only (NOT strict
# isolation); strict: enforce every REST/ticket/WS request after client rollout.
HAOLO_MARKET_ROUTING_MODE=off
HAOLO_MARKET_NODE_TIER=paid
HAOLO_MARKET_PAID_ORIGIN=https://market.youle.pro
HAOLO_MARKET_FREE_ORIGIN=https://market-free.youle.pro
# Public-market delegation from the mobile backend only; per-node independent
# secret (>=32 random characters), distinct from every business/private signer.
# Set only with compatible/strict routing after both nodes have been verified.
HAOLO_MARKET_DELEGATION_SECRET=
# Enable after candidate replay/latency acceptance; old clients stay JSON.
HAOLO_MARKET_COMPACT_ENABLED=false
HAOLO_MARKET_SESSION_MAX_MS=900000

HAOLO_PRIVATE_PROXY_HOST=0.0.0.0
HAOLO_PRIVATE_PROXY_PORT=8788
HAOLO_PRIVATE_PROXY_TLS_CERT=
HAOLO_PRIVATE_PROXY_TLS_KEY=
HAOLO_PRIVATE_PROXY_MAX_CONNECTIONS_PER_USER=6
HAOLO_PRIVATE_PROXY_CONNECTS_PER_MINUTE=60
HAOLO_PRIVATE_PROXY_IDLE_TIMEOUT_MS=180000
HAOLO_PRIVATE_PROXY_MAX_TUNNEL_MS=30000
HAOLO_PRIVATE_PROXY_ALLOWED_HOSTS=api.binance.com,fapi.binance.com
HAOLO_PRIVATE_PROXY_ALLOW_LEGACY_JWT=false

# In production list every independently NATed private egress shard. The public
# control plane and every private shard must receive exactly the same directory.
HAOLO_PRIVATE_EGRESS_SHARD_ID=sg-a
HAOLO_PRIVATE_EGRESS_SHARDS_JSON=[{"id":"sg-a","proxyUrl":"https://sg-a.binance-egress.example.com","spotWeightLimitPerMinute":6000,"futuresWeightLimitPerMinute":2400},{"id":"sg-b","proxyUrl":"https://sg-b.binance-egress.example.com","spotWeightLimitPerMinute":6000,"futuresWeightLimitPerMinute":2400}]
HAOLO_PRIVATE_PERMIT_TTL_MS=15000
HAOLO_PRIVATE_TOTAL_SAFETY_PERCENT=60
HAOLO_PRIVATE_BACKGROUND_SAFETY_PERCENT=35
HAOLO_PRIVATE_USER_SPOT_WEIGHT_PER_MINUTE=120
HAOLO_PRIVATE_USER_FUTURES_WEIGHT_PER_MINUTE=240

# Base compose binds this clear-text port to host loopback for a trusted TLS
# load balancer. Use docker-compose.tls.yml or Kubernetes for app-terminated TLS.
HAOLO_PRIVATE_PROXY_ALLOW_INSECURE=true
