HAOLO_MARKET_IMAGE=replace-with-verified-immutable-image
HAOLO_GATEWAY_METRICS_TOKEN=replace-with-new-random-secret-at-least-24-characters
HAOLO_AUTH_API_ORIGIN=https://haolo.com
HAOLO_AUTH_PROFILE_PATH=/api/auth/me
HAOLO_GATEWAY_TRUST_PROXY=false
# Enable 5,25,50,100 only after the latency/CPU/RAM replay acceptance.
HAOLO_MARKET_WS_COMPRESSION_PERCENT=0
HAOLO_MARKET_WS_COMPRESSION_THRESHOLD=1024
HAOLO_MARKET_WS_COMPRESSION_CONCURRENCY=2
HAOLO_BINANCE_SPOT_REST_BASE_URL=https://data-api.binance.vision
HAOLO_BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
HAOLO_BINANCE_SPOT_WS_URL=wss://data-stream.binance.vision:443/stream
HAOLO_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market/stream
HAOLO_BINANCE_FUTURES_PUBLIC_WS_URL=wss://fstream.binance.com/public/stream
